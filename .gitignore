# ============================================================================
#  국민대 자율주행 경진대회 2026 — xycar 프로젝트
#
#  이 파일이 제외하는 것들은 대부분 "다시 만들 수 있거나" "올릴 수 없는" 것이다.
#  각 항목에 이유를 적어두었으니 함부로 지우지 말 것.
# ============================================================================

# ── 원본 백업 ────────────────────────────────────────────────────────────
# 차량 홈디렉토리 통째 백업(849MB). GitHub 파일 크기 제한(100MB)을 크게 넘어
# push 자체가 거부된다. 로컬에만 두고 복구가 필요할 때만 쓴다.
amd.zip

# ── colcon 빌드 산출물 ──────────────────────────────────────────────────
# 아키텍처 종속(x86 ↔ 젯슨 aarch64)이라 옮겨봐야 쓸 수 없다.
# 젯슨에서 `colcon build` 하면 새로 생긴다.
build/
install/
log/
# 단, 벤더 패키지 안의 log/ 는 빌드 산출물이 아니라 원본 구성요소다.
# 위 log/ 규칙이 경로 어디서든 매칭돼서 이것까지 삼켜버린다. 빈 디렉토리라
# .gitkeep 이 필요한데 그것마저 무시되면, 젯슨에서 colcon 이
# ament_cmake_symlink_install_directory() 대상 폴더를 못 찾아 빌드가 실패한다.
!**/xycar_ultrasonic/log/

# YDLidar SDK 자체 빌드 산출물 (22MB, 위와 같은 이유)
**/YDLidar-SDK/build/

# ── 사전학습 YOLO 모델 ──────────────────────────────────────────────────
# yolo_ros 에 딸려온 범용 모델(각 50MB+). 우리 파이프라인은
# my_perception/models/best5.pt 를 쓰므로 필요 없다.
# 혹시 쓰게 되면 ultralytics 가 실행 시 자동으로 내려받는다.
yolov8*.pt
yolo11*.pt
yolov5*.pt
# (best5.pt 는 우리 학습 모델이므로 반드시 포함한다 — 위 패턴에 걸리지 않음)

# ── TensorRT 변환 산출물 ────────────────────────────────────────────────
# .onnx 는 .pt -> .engine 변환의 중간 파일이라 보관 가치가 없다.
# .engine 은 **일부러 커밋한다** — 젯슨에서 clone 하자마자 가속이 걸린 채로
# 돌게 하려는 것이다(9MB). 단 보드/JetPack 이 바뀌면 로드가 안 되니 그때는
# 다시 만들 것. 만드는 법은 VEHICLE_TEST.md §2-1 참고.
*.onnx

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── 에디터 / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── 실행 중 생기는 것 ───────────────────────────────────────────────────
# rosbag 기록
**/recordings/*
!**/recordings/.gitkeep
# 젯슨에서 만든 waypoint 원본 (평활화 전). 평활화본은 올려도 된다.
*_raw.csv

# NOTE: my_slam/maps/ 의 지도(.pgm/.yaml)는 **일부러 제외하지 않았다.**
#       트랙 지도는 팀이 공유해야 하는 산출물이고 크기도 작다.

# my_driver/tools/pipeline_sim.py 로 만든 단계별 시각화 영상 (수십MB, 다시 만들면 그만)
reference/videos/pipeline_out/

# ── 도커 이미지 조사 덤프 ───────────────────────────────────────────────
# ROS1 모터 도커를 분석할 때 떠 본 `docker history/inspect` 출력.
# 필요하면 그 명령을 다시 치면 그만이라 저장소에 둘 이유가 없다.
img_history.txt
img_inspect.json
img_motor.txt
img_pkgs.txt

# ── AMD 차량 잔재 ───────────────────────────────────────────────────────
# AMD(x86) 차량 지원은 걷어냈다(커밋 83e1964). 남은 워크스페이스 사본은
# 빌드 산출물이라 다시 만들 수 없는 것이 없다. 실수로 커밋되지 않게 막는다.
amd/

# ── 소스 트리 안의 임시 백업 zip ────────────────────────────────────────
# 작업 중 손으로 뜬 study 패키지 스냅샷(12MB). 히스토리가 이미 같은 내용을
# 담고 있으므로 저장소에 둘 이유가 없다.
xycar_ws/src/*.Zip
xycar_ws/src/*.zip
