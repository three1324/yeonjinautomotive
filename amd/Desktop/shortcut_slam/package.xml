<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>shortcut_slam</name>
  <version>0.0.1</version>
  <description>
    숏컷(좌회전 2회) 구간용 독립 SLAM 매핑 검증 패키지.
    휠 오도메트리가 없어 rf2o_laser_odometry(스캔 매칭 오도메트리) + slam_toolbox(매핑) 조합을 사용한다.
    주행 코드(race_manager 등)와는 분리되어 있으며, 이 패키지 안에서 라이다 토픽을 직접 구독한다.
  </description>
  <maintainer email="biscuit2354@khu.ac.kr">master</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <!--
    TODO(5): 아래 두 패키지가 워크스페이스/시스템에 이미 설치되어 있는지 확인 필요.
    미설치 시:
      slam_toolbox         -> sudo apt install ros-humble-slam-toolbox
      rf2o_laser_odometry   -> Humble용 apt 바이너리가 없을 수 있음.
                               https://github.com/MAPIRlab/rf2o_laser_odometry 의 ros2 브랜치를
                               워크스페이스 src/ 에 clone 후 함께 colcon build 필요.
  -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
