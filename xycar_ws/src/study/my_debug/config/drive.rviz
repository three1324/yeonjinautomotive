# xycar 주행 시각화 RViz2 설정
#
#   ros2 launch my_debug viz.launch.py
#   (또는 통합 launch 에서  ros2 launch my_bringup drive_amd.launch.py rviz:=true)
#
# 등록된 패널:
#   Image  /debug_image     ← 좌: YOLO 검출 / 우: 차선(변환) — perception_node 2분할 영상
#   Image  /image_raw       ← 원본 카메라
#   LaserScan /scan         ← 라이다 원시 스캔 (**기본 off** — 아래 참고)
#   PointCloud2 /viz/scan_cloud  ← viz_node 가 변환한 포인트클라우드
#                                  (라바콘 구간에서는 자동으로 멈춘다)
#   MarkerArray /rubbercone/cones ← 콘 하나 = 큰 점 하나.
#                                   **파랑 = 좌측 사슬 / 빨강 = 우측 사슬**
#   Odometry /viz/odom      ← 차량 위치/자세
#   Path /viz/driven_path   ← 지나온 궤적 (흰색)
#   Path /viz/plan_path     ← 현재 명령의 예측 경로 (초록)
#   MarkerArray /viz/markers ← FSM 상태 텍스트(노랑=차선 / 빨강=라바콘) + 차체
#
# [2026-08-22] 라바콘 구간에서는 **점 구름을 안 보여준다.**
#   그 구간에서 알고 싶은 건 "점이 어디 있나"가 아니라 **"어느 콘이 어느
#   벽으로 배정됐나"** 이고, 점이 깔려 있으면 그게 안 보이기 때문이다.
#     - 원시 LaserScan 디스플레이는 기본 off (필요하면 트리에서 켤 것)
#     - /viz/scan_cloud 는 구간 안에서 viz_node 가 발행을 멈춘다
#       (viz_node 파라미터 hide_scan_in_cone_zone:=false 로 끌 수 있다)
#     - 대신 /rubbercone/cones 가 콘을 좌 파랑 / 우 빨강 큰 점으로 낸다
#   좌/우 배정이 틀리면(한 벽이 두 색으로 갈리면) 바로 그게 버그다.
#
# 라이다에서 나온 복도 중앙선(/viz/ref_path, /corridor_path, /cone_walls)은
# 전부 뺐다 — obstacle_node 를 지웠기 때문이다(2026-08-21). 라이다를 쓰는
# 노드는 rubbercone_node 하나뿐이고, 그 시각화는 /rubbercone/debug_image 에 있다.
#
# 데이터가 안 보이면 좌측 트리에서 해당 Display 의 Topic 이 실제 토픽명과 같은지,
# Fixed Frame(odom) TF 가 오고 있는지 먼저 확인할 것.
Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Paths1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: 1) YOLO + lane (/debug_image)
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /debug_image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: camera (/image_raw)
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /image_raw
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 255
      Color Transformer: Intensity
      Enabled: false
      Name: LaserScan (/scan) - 기본 off
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: PointCloud2 (/viz/scan_cloud)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.03
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /viz/scan_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: Odometry (/viz/odom)
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.3
        Axes Radius: 0.03
        Color: 255; 25; 0
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /viz/odom
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 255; 255
      Enabled: true
      Head Diameter: 0
      Head Length: 0
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: driven path (/viz/driven_path)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /viz/driven_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0
      Head Length: 0
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.04
      Name: plan path (/viz/plan_path)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /viz/plan_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: cones (/rubbercone/cones)
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubbercone/cones
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: state markers (/viz/markers)
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /viz/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: -1.5707963705062866
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 120
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1600
  X: 60
  Y: 60
