#!/usr/bin/env bash
# ROS1(도커) 모터/VESC + ros1_bridge 실행 스크립트.
#
# 원본(~/xycar_ws/etc/motor_vesc/motor)이 삭제되어 JETSON_ROS1_DOCKER_MOTOR.md §5
# 의 분석 내용대로 복원했다. 원본과 다른 점은 두 가지뿐이다:
#   - 경로: /home/xytron -> $HOME (이 장비는 e-on 계정)
#   - ROS_DOMAIN_ID=47 을 명시. 데스크톱 런처는 `bash -c` 로 돌아 .bashrc 를
#     읽지 않는다. 도메인이 안 맞으면 브릿지가 우리 ROS2 노드를 못 본다.
#
# 이 파일은 레포 안에 둔다. ~/xycar_ws 처럼 홈에 두면 그 디렉터리를 지우는
# 순간 또 사라진다 (2026-08-21 에 실제로 그렇게 잃어버렸다).

set -u

CONTAINER=ros1_container
IMAGE=osrf/ros:noetic-xycar
NOETIC_WS="$HOME/noetic_ws"
BRIDGE_WS="$HOME/ros-humble-ros1-bridge"
export ROS_DOMAIN_ID=47
export ROS_MASTER_URI=http://localhost:11311

BRIDGE_PID=""
# MOTOR_KEEP=1 : 대화형 쉘을 띄우지 않고, 종료 시 정리도 하지 않는다.
# 터미널 없이(스크립트/원격 점검) 기동만 확인할 때 쓴다. 평소 런처 경로는
# 이 변수가 없으므로 동작이 그대로다.
MOTOR_KEEP="${MOTOR_KEEP:-0}"

cleanup() {
    [ "$MOTOR_KEEP" = "1" ] && return 0
    echo
    echo "[5] 정리 중..."
    [ -n "$BRIDGE_PID" ] && kill "$BRIDGE_PID" 2>/dev/null
    docker stop "$CONTAINER" >/dev/null 2>&1
    echo "    브릿지 종료, 컨테이너 정지 완료."
}
trap cleanup EXIT INT TERM

# [0] 모터 포트 확인 -----------------------------------------------------
if [ ! -e /dev/ttyMOTOR ]; then
    echo "❌ /dev/ttyMOTOR 가 없다. VESC USB 연결과 udev 규칙을 확인할 것."
    echo "   (ls -l /dev/ttyACM* 로 장치가 붙었는지부터 본다)"
    read -rp "엔터를 누르면 종료..."
    exit 1
fi
echo "[0] /dev/ttyMOTOR -> $(readlink -f /dev/ttyMOTOR)"

# [1] 기존 컨테이너 정리 -------------------------------------------------
echo "[1] 기존 $CONTAINER 정리"
docker stop "$CONTAINER" >/dev/null 2>&1
docker rm   "$CONTAINER" >/dev/null 2>&1

# [2] ROS1 컨테이너 기동 -------------------------------------------------
echo "[2] $CONTAINER 기동"
docker run -d \
    --privileged --name "$CONTAINER" --network host \
    -e DISPLAY="$DISPLAY" -v /tmp/.X11-unix:/tmp/.X11-unix \
    -v "$HOME/Downloads:/root/Downloads" \
    -v "$NOETIC_WS:/root/noetic_ws" \
    -v /dev:/dev --group-add dialout \
    -e ROS_MASTER_URI="$ROS_MASTER_URI" \
    "$IMAGE" \
    bash -ci "source /opt/ros/noetic/setup.bash; \
              source /root/noetic_ws/devel/setup.bash; motor" \
    || { echo "❌ docker run 실패"; read -rp "엔터..."; exit 1; }

# roscore/노드가 올라올 시간. 컨테이너 안의 `motor` 는 .bashrc 의 alias 라
# (roslaunch xycar_motor xycar_motor.launch) bash -ci 의 -i 가 반드시 필요하다.
sleep 5

if [ -z "$(docker ps -q -f name="^${CONTAINER}$")" ]; then
    echo "❌ 컨테이너가 바로 죽었다. 로그:"
    docker logs "$CONTAINER" 2>&1 | tail -30
    read -rp "엔터..."
    exit 1
fi

# [3] 호스트 ros1_bridge -------------------------------------------------
echo "[3] ros1_bridge 기동 (ROS_DOMAIN_ID=$ROS_DOMAIN_ID)"
# ROS 의 setup.bash 들은 미정의 변수를 참조한다 (AMENT_TRACE_SETUP_FILES 등).
# set -u 상태로 source 하면 그 자리에서 쉘이 죽는다 — 실제로 죽었다. 잠시 끈다.
set +u
source /opt/ros/humble/setup.bash
source "$BRIDGE_WS/install/local_setup.bash"
set -u
ros2 run ros1_bridge dynamic_bridge --bridge-all-topics &
BRIDGE_PID=$!
sleep 3

# [4] 확인 + 쉘 유지 -----------------------------------------------------
echo "[4] ROS1 노드 확인"
docker exec "$CONTAINER" bash -ci \
    "source /opt/ros/noetic/setup.bash; source /root/noetic_ws/devel/setup.bash; rosnode list" 2>&1 \
    | grep -v '^$'
echo
echo "   /xycar_motor /vesc_driver /ackermann_to_vesc 가 보이면 정상이다."
if [ "$MOTOR_KEEP" = "1" ]; then
    echo "   MOTOR_KEEP=1 — 쉘을 띄우지 않고 그대로 둔다."
    echo "   정리하려면: docker stop $CONTAINER; kill $BRIDGE_PID"
    exit 0
fi
echo "   이 쉘을 나가면(exit) 브릿지와 컨테이너가 함께 정리된다."
echo
docker exec -it "$CONTAINER" bash
